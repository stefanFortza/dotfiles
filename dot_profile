# ~/.profile: executat la login-ul de sesiune pentru variabile globale de mediu.

# 1. Variabile globale de mediu
export EDITOR="nvim"
export VISUAL="nvim"
export ANDROID_HOME="$HOME/Android/Sdk"

# 2. Constructie curata PATH (fara duplicate hardcodate)
add_to_path() {
  if [ -d "$1" ] && case ":$PATH:" in *":$1:"*) false ;; *) true ;; esac then
    PATH="$1:$PATH"
  fi
}

# Unelte locale si pachete
add_to_path "$HOME/.local/bin"
add_to_path "$HOME/.local/share/JetBrains/Toolbox/scripts"
add_to_path "$HOME/.local/share/pnpm"
add_to_path "$ANDROID_HOME/cmdline-tools/latest/bin"
add_to_path "$ANDROID_HOME/platform-tools"
add_to_path "/home/linuxbrew/.linuxbrew/bin"
add_to_path "/home/linuxbrew/.linuxbrew/sbin"
add_to_path "/var/lib/snapd/snap/bin"

unset -f add_to_path
export PATH
. "$HOME/.cargo/env"
