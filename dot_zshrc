# =======================================================
# 1. ZSH ENVIRONMENT & UNIQUE PATHS
# =======================================================
# Asigura eliminarea duplicatelor din PATH automat
typeset -U path PATH

path=(
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/.bun/bin"
  "$HOME/.opencode/bin"
  "$HOME/.pub-cache/bin"
  "/usr/local/texlive/2024/bin/x86_64-linux"
  "/var/lib/snapd/snap/bin"
  "/snap/bin"
  $path
)
export PATH

# Completions path
[[ -d "$HOME/.zsh/completions" ]] && fpath=("$HOME/.zsh/completions" $fpath)

# =======================================================
# 2. EXPORTS NATIVE ZSH
# =======================================================
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt EXTENDED_HISTORY

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

export EDITOR='nvim'
export VISUAL='nvim'
export CLICOLOR=1
export DOCKER_CONFIG="$HOME/.docker"
export ANDROID_HOME="$HOME/Android/Sdk"
export PNPM_HOME="$HOME/.local/share/pnpm"
export path=("$PNPM_HOME" $path)

# Less colors
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

[[ $- == *i* ]] && stty -ixon

# =======================================================
# 3. OH-MY-ZSH & PLUGINS
# =======================================================
export ZSH="$HOME/.oh-my-zsh"

plugins=(
  git
  zsh-autosuggestions
  zsh-vi-mode
  sudo
  docker
  docker-compose
  rust
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"


# =======================================================
# 4. ALIASES & SHORTCUTS
# =======================================================
# Editor & core
alias vim='nvim'
alias vi='nvim'
alias ezrc='nvim ~/.zshrc'

# Modern utils (ripgrep, batcat pe Ubuntu, eza)
command -v rg >/dev/null 2>&1 && alias grep='rg'
command -v batcat >/dev/null 2>&1 && alias cat='batcat'
command -v bat >/dev/null 2>&1 && alias cat='bat'

alias ls='eza --icons --color=always --group-directories-first'
alias ll='eza -alF --icons --color=always --group-directories-first'
alias la='eza -a --icons --color=always --group-directories-first'
alias l='eza -F --icons --color=always --group-directories-first'
alias tree='tree -CAhF --dirsfirst'

alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias cls='clear'
alias kssh="kitty +kitten ssh"

# Git helpers
alias gcom='git add . && git commit -m'
lazyg() { git add . && git commit -m "$1" && git push; }

# =======================================================
# 5. RUNTIME MANAGERS (OPTIMIZATE)
# =======================================================

# Bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Zoxide & Prompt
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
# External script configs (daca exista)
[[ -f "$HOME/github/music-player-service/aliases.sh" ]] && source "$HOME/github/music-player-service/aliases.sh"

# =======================================================
# FZF & FD CONFIGURATION
# =======================================================
# Seteaza fd ca backend implicit pentru fzf (ignora .git, respecta .gitignore)
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
fi

# Aspect vizual fzf
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --inline-info --color=dark"

# Incarcare keybindings oficiale fzf pentru Zsh (Ctrl+R, Ctrl+T, Alt+C)
if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
fi

# =======================================================
# ALIASES & HELPERS (LAZYGIT)
# =======================================================
alias lg='lazygit'

eval "$(/home/stefantacu/.local/bin/mise activate zsh)" # added by https://mise.run/zsh
