# 1. Non-interactive guard (pentru scp, rsync, scripturi automate)
case $- in *i*) ;;
*) return ;;
esac

# 2. Hand-off sigur catre Fish doar daca rulam intr-un terminal interactiv (TTY)
if [[ $- == *i* ]] && [ -t 0 ] && command -v fish >/dev/null 2>&1; then
  exec fish
fi

# ==============================================================================
# Fallback Bash (se executa doar daca Fish nu este instalat sau e apelat explicit)
# ==============================================================================

# Istoric si optiuni de baza
shopt -s checkwinsize histappend
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups

# Variabile esentiale de mediu
export EDITOR="nvim"
export VISUAL="nvim"

# Integrare mise (activeaza automat shim-urile, inclusiv gh, rust, node, etc.)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
elif [ -d "$HOME/.local/share/mise/shims" ]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

# Completari si scurtaturi rapide
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

alias vim='nvim'
alias vi='nvim'
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
. "$HOME/.cargo/env"
